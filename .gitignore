# --- Node modules (EXISTS in both backend and frontend) ---
node_modules/
**/node_modules/

# --- Environment files (EXISTS in backend/.env) -----------
.env
.env.local
.env.production
.env.development
.env.test
**/.env
**/.env.local
**/.env.production

# --- Frontend build output (created by npm run build) -----
dist/
build/
**/dist/
**/build/

# --- Database backup (created if you run mongodump) -------
backup/
*.dump
*.bson

# --- Log files (created automatically by Node.js) ---------
logs/
*.log
npm-debug.log*
yarn-debug.log*

# --- OS generated files -----------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# --- Editor folders ---------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- Temporary and cache ----------------------------------
*.tmp
*.temp
.cache/
.parcel-cache/
